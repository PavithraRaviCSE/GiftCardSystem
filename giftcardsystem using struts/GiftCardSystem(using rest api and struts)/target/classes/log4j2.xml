<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="STDOUT" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n" />
		</Console>

		<RollingFile name="mylogger" fileName="logs/specific.log"
			filePattern="logs/archive/specific-%d{yyyy-MM-dd-HH}.log.gz"> <!--HH hours  -->
			<PatternLayout
				pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n" />
			<Policies>
				<TimeBasedTriggeringPolicy interval="2"
					modulate="true" />  <!-- Rotates every 2 hours -->
			</Policies>
		</RollingFile>


		<!-- <File name="mylogger" fileName="logs/specific.log" append="true"> 
			<PatternLayout pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n" /> (timestamp, 
			level, thread, class, file, line, message). </File> -->
	</Appenders>
	<Loggers>
		<Logger name="com.opensymphony.xwork2" level="debug" />
		<Logger name="org.apache.struts2" level="debug" />
		<Logger name="freemarker.cache" level="warn" additivity="false">   <!-- additivity = false the freemarker log only sen dtothe console -->
			<AppenderRef ref="STDOUT" />
		</Logger>
		<Logger name="com.example.interceptor.SessionInterceptor"
			level="info" additivity="false">
			<AppenderRef ref="mylogger" />
		</Logger>
		<Root level="warn">
			<AppenderRef ref="STDOUT" />
		</Root>
	</Loggers>
</Configuration>

<!-- logger levels TRACE. DEBUG. INFO. WARN. ERROR. FATAL. OFF. -->